<%- include("../partials/head", { title: "Cluster Resources & Allocation" }) %>
<%- include("../partials/ambient") %>
<%- include("../partials/topbar") %>
<%- include("../partials/sidebar") %>

<style>
.res-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  transition: all 0.2s ease;
}
.res-card:hover {
  border-color: rgba(56, 189, 248, 0.4);
  transform: translateY(-2px);
}
.res-bar-bg {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999px;
  height: 8px;
  overflow: hidden;
  margin: 12px 0 8px 0;
}
.res-bar-fill {
  height: 100%;
  border-radius: 999px;
  transition: width 0.4s ease;
}
</style>

<div class="main">
  <!-- Top Header -->
  <div class="flex-between mb-4">
    <div>
      <div class="muted text-sm mb-1">
        <a href="/admin" class="muted">Admin</a> / <span style="color:var(--accent);font-weight:600">Resources</span>
      </div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.4px;margin:0;display:flex;align-items:center;gap:10px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="24" height="24" style="color:var(--accent)"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        Cluster Resources &amp; Allocation
      </h2>
    </div>

    <div class="flex" style="gap:8px">
      <span class="pill pill-green"><span class="pulse-dot"></span> Live Telemetry</span>
      <a href="/admin/nodes" class="btn btn-sm">Node Details</a>
    </div>
  </div>

  <!-- Resource Cards Row 1 -->
  <div class="grid grid-3 mb-4" style="gap:16px">
    <!-- CPU Cores -->
    <div class="res-card">
      <div class="flex-between mb-2">
        <div style="font-weight:700;font-size:15px;color:#fff;display:flex;align-items:center;gap:8px">
          <span>⚡</span> CPU Cores Allocation
        </div>
        <span class="pill <%= usage.cpuCores.percentage > 90 ? 'pill-red' : usage.cpuCores.percentage > 70 ? 'pill-amber' : 'pill-green' %>" style="font-size:11px">
          <%= usage.cpuCores.percentage %>% Allocated
        </span>
      </div>

      <div class="flex-between text-sm mt-3">
        <span class="muted">Virtual Provisioned</span>
        <span class="font-semibold mono" style="color:var(--accent)"><%= usage.cpuCores.allocated %> vCPUs / <%= usage.cpuCores.limit %> Physical Cores</span>
      </div>

      <div class="res-bar-bg">
        <div class="res-bar-fill" style="width:<%= Math.min(100, usage.cpuCores.percentage) %>%;background:<%= usage.cpuCores.percentage > 90 ? '#ef4444' : usage.cpuCores.percentage > 70 ? '#fbbf24' : 'var(--accent)' %>"></div>
      </div>

      <div class="flex-between text-sm muted mt-1" style="font-size:11.5px">
        <span>Host Physical Load: <b style="color:#fff"><%= usage.cpuCores.livePercent %>%</b></span>
        <span>Overcommit: <b style="color:#38bdf8"><%= (usage.cpuCores.allocated / (usage.cpuCores.limit || 1)).toFixed(2) %>x</b></span>
      </div>
    </div>

    <!-- RAM Memory -->
    <div class="res-card">
      <div class="flex-between mb-2">
        <div style="font-weight:700;font-size:15px;color:#fff;display:flex;align-items:center;gap:8px">
          <span>💾</span> RAM Memory Allocation
        </div>
        <span class="pill <%= usage.ram.percentage > 90 ? 'pill-red' : usage.ram.percentage > 70 ? 'pill-amber' : 'pill-green' %>" style="font-size:11px">
          <%= usage.ram.percentage %>% Allocated
        </span>
      </div>

      <div class="flex-between text-sm mt-3">
        <span class="muted">Virtual Provisioned</span>
        <span class="font-semibold mono" style="color:var(--accent)"><%= usage.ram.allocatedGb %> GB / <%= usage.ram.limitGb %> GB</span>
      </div>

      <div class="res-bar-bg">
        <div class="res-bar-fill" style="width:<%= Math.min(100, usage.ram.percentage) %>%;background:<%= usage.ram.percentage > 90 ? '#ef4444' : usage.ram.percentage > 70 ? '#fbbf24' : 'var(--accent)' %>"></div>
      </div>

      <div class="flex-between text-sm muted mt-1" style="font-size:11.5px">
        <span>Host Physical Used: <b style="color:#fff"><%= usage.ram.liveUsedMb %> MB (<%= usage.ram.livePercent %>%)</b></span>
        <span>Free: <b style="color:#34d399"><%= Math.max(0, (usage.ram.limitMb - usage.ram.allocatedMb) / 1024).toFixed(1) %> GB</b></span>
      </div>
    </div>

    <!-- Disk Storage -->
    <div class="res-card">
      <div class="flex-between mb-2">
        <div style="font-weight:700;font-size:15px;color:#fff;display:flex;align-items:center;gap:8px">
          <span>💿</span> Disk Storage Allocation
        </div>
        <span class="pill <%= usage.disk.percentage > 90 ? 'pill-red' : usage.disk.percentage > 70 ? 'pill-amber' : 'pill-green' %>" style="font-size:11px">
          <%= usage.disk.percentage %>% Allocated
        </span>
      </div>

      <div class="flex-between text-sm mt-3">
        <span class="muted">Virtual Disks Size</span>
        <span class="font-semibold mono" style="color:var(--accent)"><%= usage.disk.allocatedGb %> GB / <%= usage.disk.limitGb %> GB</span>
      </div>

      <div class="res-bar-bg">
        <div class="res-bar-fill" style="width:<%= Math.min(100, usage.disk.percentage) %>%;background:<%= usage.disk.percentage > 90 ? '#ef4444' : usage.disk.percentage > 70 ? '#fbbf24' : 'var(--accent)' %>"></div>
      </div>

      <div class="flex-between text-sm muted mt-1" style="font-size:11.5px">
        <span>Host Physical Used: <b style="color:#fff"><%= usage.disk.liveUsedGb %> GB (<%= usage.disk.livePercent %>%)</b></span>
        <span>Available: <b style="color:#34d399"><%= Math.max(0, parseFloat(usage.disk.limitGb) - usage.disk.allocatedGb).toFixed(1) %> GB</b></span>
      </div>
    </div>
  </div>

  <!-- Resource Cards Row 2 (Bandwidth & IPv4) -->
  <div class="grid grid-2 mb-4" style="gap:16px">
    <div class="res-card">
      <div class="flex-between mb-2">
        <div style="font-weight:700;font-size:15px;color:#fff;display:flex;align-items:center;gap:8px">
          <span>🌐</span> Monthly Bandwidth Quota
        </div>
        <span class="pill pill-blue" style="font-size:11px"><%= usage.bandwidth.percentage %>% Used</span>
      </div>
      <div class="flex-between text-sm mt-3">
        <span class="muted">Provisioned Bandwidth</span>
        <span class="font-semibold mono" style="color:#38bdf8"><%= usage.bandwidth.allocatedGb %> GB / <%= usage.bandwidth.limitGb %> GB</span>
      </div>
      <div class="res-bar-bg">
        <div class="res-bar-fill" style="width:<%= Math.min(100, usage.bandwidth.percentage) %>%;background:#38bdf8"></div>
      </div>
      <div class="flex-between text-sm muted mt-1" style="font-size:11.5px">
        <span>Network Interface: <b style="color:#fff">eth0 (Active)</b></span>
        <span>Unallocated Pool: <b style="color:#34d399"><%= Math.max(0, usage.bandwidth.limitGb - usage.bandwidth.allocatedGb) %> GB</b></span>
      </div>
    </div>

    <div class="res-card">
      <div class="flex-between mb-2">
        <div style="font-weight:700;font-size:15px;color:#fff;display:flex;align-items:center;gap:8px">
          <span>🔢</span> IPv4 Addresses Provisioned
        </div>
        <span class="pill pill-blue" style="font-size:11px"><%= usage.ipv4.allocated %> Assigned</span>
      </div>
      <div class="flex-between text-sm mt-3">
        <span class="muted">Assigned Virtual IPs</span>
        <span class="font-semibold mono" style="color:#38bdf8"><%= usage.ipv4.allocated %> / <%= usage.ipv4.limit %> Addresses</span>
      </div>
      <div class="res-bar-bg">
        <div class="res-bar-fill" style="width:<%= Math.min(100, usage.ipv4.percentage) %>%;background:#38bdf8"></div>
      </div>
      <div class="flex-between text-sm muted mt-1" style="font-size:11.5px">
        <span>Default Gateway: <b style="color:#fff">127.0.0.1</b></span>
        <span>Available IPs: <b style="color:#34d399"><%= Math.max(0, usage.ipv4.limit - usage.ipv4.allocated) %></b></span>
      </div>
    </div>
  </div>

  <!-- VM Resource Allocation Table -->
  <div class="card" style="background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px">
    <div class="flex-between mb-3">
      <div>
        <h3 style="font-size:16px;font-weight:700;margin:0;color:#fff">Virtual Machine Resource Distribution</h3>
        <div class="muted text-sm mt-1">Per-instance resource provisioning across cluster hardware</div>
      </div>
      <span class="pill pill-green"><%= vms.length %> Total VMs</span>
    </div>

    <div style="overflow-x:auto">
      <table class="table" style="font-size:13px;margin:0">
        <thead>
          <tr>
            <th>Virtual Machine</th>
            <th>Owner</th>
            <th>Status</th>
            <th>vCPU</th>
            <th>RAM Memory</th>
            <th>Disk Size</th>
            <th>SSH / IP</th>
            <th style="text-align:right">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (!vms || vms.length === 0) { %>
            <tr>
              <td colspan="8" style="text-align:center;padding:30px;color:var(--text-dim)">
                No virtual machines created yet.
              </td>
            </tr>
          <% } else { %>
            <% vms.forEach(function(vm) { %>
              <tr>
                <td>
                  <a href="/servers/<%= vm.id %>" style="font-weight:700;color:#fff;text-decoration:none">
                    <%= vm.name %>
                  </a>
                  <div class="muted text-sm mono" style="font-size:11px">VM ID: #<%= vm.id %> · <%= vm.os_type || "linux" %></div>
                </td>
                <td>
                  <div style="color:var(--text)"><%= vm.owner ? vm.owner.username : "admin" %></div>
                  <div class="muted text-sm" style="font-size:11px"><%= vm.owner ? vm.owner.email : "" %></div>
                </td>
                <td>
                  <span class="pill <%= vm.isRunning ? "pill-green" : "pill-gray" %>" style="font-size:11px">
                    <%= vm.isRunning ? "● Running" : "Stopped" %>
                  </span>
                </td>
                <td class="mono font-semibold" style="color:var(--accent)">
                  <%= vm.cpus || 1 %> Cores
                </td>
                <td class="mono font-semibold">
                  <%= vm.memory || 2048 %> MB
                </td>
                <td class="mono font-semibold" style="color:#34d399">
                  <%= vm.disk_size || "20G" %>
                </td>
                <td class="mono" style="font-size:11.5px">
                  Port :<%= vm.ssh_port || 22 %>
                </td>
                <td style="text-align:right">
                  <div class="flex" style="gap:6px;justify-content:flex-end">
                    <a href="/servers/<%= vm.id %>/console" class="btn btn-sm" style="font-size:11px;padding:3px 8px">Console</a>
                    <a href="/servers/<%= vm.id %>" class="btn btn-sm btn-primary" style="font-size:11px;padding:3px 8px">Manage</a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include("../partials/foot") %>
