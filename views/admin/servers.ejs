<%- include('../partials/head', { title: 'Server Management' }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-4">
    <div>
      <h2 style="font-size:24px;font-weight:800;letter-spacing:-0.4px">Server Management</h2>
      <div class="muted" style="margin-top:2px">Manage all virtual machines across your cluster</div>
    </div>
    <a class="btn btn-primary" href="/admin/servers/create">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 5v14M5 12h14"/></svg>
      Create Virtual Machine
    </a>
  </div>

  <div class="card">
    <div class="flex-between mb-3" style="flex-wrap:wrap;gap:10px">
      <div class="flex" style="gap:10px;align-items:center">
        <div class="card-title" style="margin:0">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
          All Cluster Instances (<%= vms.length %>)
        </div>
      </div>

      <div class="flex" style="gap:8px;align-items:center;flex-wrap:wrap">
        <input type="search" id="serverFilter" placeholder="Filter by name, owner, or port..." style="width:230px;padding:5px 10px;font-size:12.5px;border-radius:6px"/>
        <div class="flex" style="background:rgba(0,0,0,0.3);border:1px solid var(--border);border-radius:8px;padding:2px;gap:2px">
          <button id="btnAdminCards" class="btn btn-sm btn-primary" onclick="setAdminVmView('cards')" title="Card View" style="padding:4px 8px;font-size:12px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Cards
          </button>
          <button id="btnAdminTable" class="btn btn-sm" onclick="setAdminVmView('table')" title="Table View" style="padding:4px 8px;font-size:12px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            Table
          </button>
        </div>
      </div>
    </div>

    <% if (vms.length === 0) { %>
      <div class="empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
        <p style="font-size:15px;font-weight:600;color:var(--text)">No servers found</p>
        <p class="muted">No virtual machines have been provisioned yet.</p>
        <div class="mt-3"><a href="/admin/servers/create" class="btn btn-primary">Create First Server</a></div>
      </div>
    <% } else { %>
      <!-- Default Card View -->
      <div id="adminCardGrid" class="grid grid-3 mb-2" style="gap:14px;margin-top:10px">
        <% for (const v of vms) { %>
          <div class="admin-card-item" data-search="<%= v.name %> <%= v.owner_name %> <%= v.username %> <%= v.hostname %> <%= v.ssh_port %> <%= v.os_type %>" style="border:1px solid var(--border);border-radius:12px;padding:16px;background:rgba(255,255,255,0.02);display:flex;flex-direction:column;justify-content:space-between;gap:12px;box-shadow:0 4px 14px rgba(0,0,0,0.15)">
            <div>
              <div class="flex-between mb-2">
                <div class="flex" style="gap:10px;align-items:center">
                  <div style="width:36px;height:36px;border-radius:10px;background:var(--glass);display:grid;place-items:center;border:1px solid var(--border)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-2)" stroke-width="2" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
                  </div>
                  <div>
                    <a href="/admin/servers/<%= v.id %>" style="font-weight:700;color:#fff;font-size:14.5px"><%= v.name %></a>
                    <div class="muted mono text-sm" style="font-size:11px"><%= v.username %>@<%= v.hostname || 'localhost' %></div>
                  </div>
                </div>
                <span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>" style="font-size:11px">
                  <%= v.status === 'running' ? '● Online' : 'Stopped' %>
                </span>
              </div>

              <div class="flex" style="gap:6px;margin-bottom:10px;align-items:center;flex-wrap:wrap">
                <span class="muted text-sm font-bold" style="font-size:11px;background:rgba(255,255,255,0.05);padding:2px 7px;border-radius:4px">Owner: <%= v.owner_name %></span>
                <span class="pill pill-blue font-bold" style="font-size:10.5px"><%= v.os_type || 'linux' %></span>
                <span class="pill mono font-bold" style="font-size:10.5px;color:var(--accent-2)">Port <%= v.ssh_port %></span>
              </div>

              <div style="background:rgba(0,0,0,0.25);border:1px solid var(--border);border-radius:8px;padding:8px 10px;display:grid;grid-template-columns:repeat(3,1fr);gap:6px;text-align:center">
                <div>
                  <div class="muted text-sm" style="font-size:10.5px">vCPU</div>
                  <div style="font-weight:700;font-size:12.5px;color:#fff"><%= v.cpus %> Core<%= v.cpus > 1 ? 's' : '' %></div>
                </div>
                <div>
                  <div class="muted text-sm" style="font-size:10.5px">RAM</div>
                  <div style="font-weight:700;font-size:12.5px;color:#fff"><%= v.memory >= 1024 ? (v.memory/1024).toFixed(1) + ' GB' : v.memory + ' MB' %></div>
                </div>
                <div>
                  <div class="muted text-sm" style="font-size:10.5px">Disk</div>
                  <div style="font-weight:700;font-size:12.5px;color:#fff"><%= v.disk_size || '20G' %></div>
                </div>
              </div>
            </div>

            <div class="flex-between" style="border-top:1px solid var(--border);padding-top:10px;gap:6px;flex-wrap:wrap">
              <div class="flex" style="gap:4px">
                <a class="btn btn-sm" href="/servers/<%= v.id %>/console" title="Open Terminal">Terminal</a>
                <% if (v.status === 'running') { %>
                  <button class="btn btn-sm btn-danger" onclick="action(<%= v.id %>,'stop')">Stop</button>
                  <button class="btn btn-sm btn-primary" onclick="action(<%= v.id %>,'restart')">Restart</button>
                <% } else { %>
                  <button class="btn btn-sm btn-green" onclick="action(<%= v.id %>,'start')">Start</button>
                <% } %>
              </div>
              <div class="flex" style="gap:4px">
                <a class="btn btn-sm" href="/admin/servers/<%= v.id %>">Manage</a>
                <button class="btn btn-sm btn-danger" onclick="del(<%= v.id %>)">✕</button>
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Alternative Table View -->
      <div id="adminTableView" class="table-wrap" style="display:none">
        <table id="serverTable">
          <thead>
            <tr>
              <th>Server Name</th>
              <th>Owner</th>
              <th>OS / Distro</th>
              <th>Hardware Specs</th>
              <th>SSH Port</th>
              <th>Status</th>
              <th>Created</th>
              <th class="right">Actions</th>
            </tr>
          </thead>
          <tbody>
          <% for (const v of vms) { %>
            <tr class="server-row" data-search="<%= v.name %> <%= v.owner_name %> <%= v.username %> <%= v.hostname %> <%= v.ssh_port %> <%= v.os_type %>">
              <td>
                <div class="flex" style="gap:10px">
                  <div style="width:32px;height:32px;border-radius:9px;background:var(--glass);display:grid;place-items:center;border:1px solid var(--border)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-2)" stroke-width="2" width="16" height="16"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
                  </div>
                  <div>
                    <a href="/admin/servers/<%= v.id %>" style="font-weight:700;color:#fff;font-size:13.5px"><%= v.name %></a>
                    <div class="muted text-sm mono" style="font-size:11px"><%= v.username %>@<%= v.hostname || 'localhost' %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="muted font-bold"><%= v.owner_name %></span>
              </td>
              <td><span class="pill pill-blue font-bold"><%= v.os_type || '-' %></span></td>
              <td><span class="muted"><%= v.cpus %> vCPU · <%= v.memory %>MB · <%= v.disk_size %></span></td>
              <td class="mono font-bold" style="color:var(--accent-2)">Port <%= v.ssh_port %></td>
              <td><span class="pill <%= v.status === 'running' ? 'pill-green' : 'pill-gray' %>"><%= v.status %></span></td>
              <td class="muted text-sm"><%= new Date(v.created_at).toLocaleDateString() %></td>
              <td class="right">
                <div class="flex right" style="gap:6px">
                  <a class="btn btn-sm" href="/servers/<%= v.id %>/console" title="Open Terminal">Terminal</a>
                  <% if (v.status === 'running') { %>
                    <button class="btn btn-sm btn-danger" onclick="action(<%= v.id %>,'stop')">Stop</button>
                    <button class="btn btn-sm btn-primary" onclick="action(<%= v.id %>,'restart')">Restart</button>
                  <% } else { %>
                    <button class="btn btn-sm btn-green" onclick="action(<%= v.id %>,'start')">Start</button>
                  <% } %>
                  <a class="btn btn-sm" href="/admin/servers/<%= v.id %>">Manage</a>
                  <button class="btn btn-sm btn-danger" onclick="del(<%= v.id %>)">Delete</button>
                </div>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>

<script>
function setAdminVmView(mode) {
  const cardGrid = document.getElementById('adminCardGrid');
  const tableView = document.getElementById('adminTableView');
  const btnCards = document.getElementById('btnAdminCards');
  const btnTable = document.getElementById('btnAdminTable');

  if (mode === 'table') {
    if (cardGrid) cardGrid.style.display = 'none';
    if (tableView) tableView.style.display = 'block';
    if (btnCards) btnCards.className = 'btn btn-sm';
    if (btnTable) btnTable.className = 'btn btn-sm btn-primary';
    localStorage.setItem('admin_vm_view_pref', 'table');
  } else {
    if (cardGrid) cardGrid.style.display = 'grid';
    if (tableView) tableView.style.display = 'none';
    if (btnCards) btnCards.className = 'btn btn-sm btn-primary';
    if (btnTable) btnTable.className = 'btn btn-sm';
    localStorage.setItem('admin_vm_view_pref', 'cards');
  }
}

// Default to cards view
(function() {
  const pref = localStorage.getItem('admin_vm_view_pref') || 'cards';
  setAdminVmView(pref);
})();

async function action(id, a) {
  try {
    VP.toast(`Executing ${a}...`, 'info');
    await VP.api('/admin/servers/' + id + '/action', { method: 'POST', body: { action: a } });
    VP.toast(`Action ${a} processed`, 'success');
    setTimeout(() => location.reload(), 700);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

async function del(id) {
  const ok = await VP.confirmDialog('Permanently delete this server and all its storage disks? This cannot be undone!', { title: 'Delete server?' });
  if (!ok) return;
  try {
    await VP.api('/admin/servers/' + id + '/action', { method: 'POST', body: { action: 'delete' } });
    VP.toast('Server deleted', 'success');
    setTimeout(() => location.reload(), 800);
  } catch (e) {
    VP.toast(e.message, 'error');
  }
}

document.getElementById('serverFilter')?.addEventListener('input', function() {
  const q = this.value.toLowerCase().trim();
  document.querySelectorAll('.admin-card-item').forEach(el => {
    const s = el.dataset.search ? el.dataset.search.toLowerCase() : el.textContent.toLowerCase();
    el.style.display = s.includes(q) ? 'flex' : 'none';
  });
  document.querySelectorAll('.server-row').forEach(row => {
    const s = row.dataset.search ? row.dataset.search.toLowerCase() : row.textContent.toLowerCase();
    row.style.display = s.includes(q) ? '' : 'none';
  });
});
</script>
