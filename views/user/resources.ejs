<%- include('../partials/head', { title: 'Resources ⭐', scripts: ['/vendor/chart.min.js'] }) %>
<%- include('../partials/ambient') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<div class="main">
  <div class="flex-between mb-4">
    <div>
      <h1 style="font-size:24px;font-weight:800;letter-spacing:-0.4px;margin-bottom:2px">Resources ⭐</h1>
      <div class="muted" style="margin-top:0px">Allocated cluster limits vs real-time workload consumption</div>
    </div>
    <div class="flex" style="gap:8px">
      <span class="pill pill-green"><span class="pulse-dot"></span> Live Telemetry</span>
    </div>
  </div>

  <% if (resources) { %>
  <div class="grid grid-2 mb-4">
    <div class="card">
      <div class="card-title" style="margin:0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18"/></svg>
        System Resources
      </div>
      <div style="padding:16px">
        <div class="resource-bar mb-3">
          <div class="resource-label" style="font-weight:600;margin-bottom:4px">CPU Cores</div>
          <div class="resource-info" style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
            <span id="uiCpuText"><%= resources.cpu.used %> / <%= resources.cpu.allocated %> Cores (<%= resources.cpu.vmAllocated %> Cores Provisioned)</span>
            <span id="uiCpuPct" style="font-weight:700;color:<%= resources.cpu.color === 'green' ? '#10b981' : resources.cpu.color === 'yellow' ? '#f59e0b' : '#ef4444' %>"><%= resources.cpu.percent %>%</span>
          </div>
          <div class="resource-bar-bg" style="height:7px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden">
            <div id="uiCpuBar" class="resource-bar-fill" style="width:<%= Math.min(100, resources.cpu.percent) %>%;background-color:<%= resources.cpu.color === 'green' ? '#10b981' : resources.cpu.color === 'yellow' ? '#f59e0b' : '#ef4444' %>;height:100%;border-radius:4px;transition:width 0.4s"></div>
          </div>
        </div>

        <div class="resource-bar mb-3">
          <div class="resource-label" style="font-weight:600;margin-bottom:4px">RAM Memory</div>
          <div class="resource-info" style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
            <span id="uiRamText"><%= resources.ram.used %> GB / <%= resources.ram.allocated %> GB (<%= resources.ram.vmAllocated %> GB Provisioned)</span>
            <span id="uiRamPct" style="font-weight:700;color:<%= resources.ram.color === 'green' ? '#10b981' : resources.ram.color === 'yellow' ? '#f59e0b' : '#ef4444' %>"><%= resources.ram.percent %>%</span>
          </div>
          <div class="resource-bar-bg" style="height:7px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden">
            <div id="uiRamBar" class="resource-bar-fill" style="width:<%= Math.min(100, resources.ram.percent) %>%;background-color:<%= resources.ram.color === 'green' ? '#10b981' : resources.ram.color === 'yellow' ? '#f59e0b' : '#ef4444' %>;height:100%;border-radius:4px;transition:width 0.4s"></div>
          </div>
        </div>

        <div class="resource-bar mb-3">
          <div class="resource-label" style="font-weight:600;margin-bottom:4px">Disk Storage</div>
          <div class="resource-info" style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
            <span id="uiDiskText"><%= resources.disk.used %> GB / <%= resources.disk.allocated %> GB (<%= resources.disk.vmAllocated %> GB Provisioned)</span>
            <span id="uiDiskPct" style="font-weight:700;color:<%= resources.disk.color === 'green' ? '#10b981' : resources.disk.color === 'yellow' ? '#f59e0b' : '#ef4444' %>"><%= resources.disk.percent %>%</span>
          </div>
          <div class="resource-bar-bg" style="height:7px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden">
            <div id="uiDiskBar" class="resource-bar-fill" style="width:<%= Math.min(100, resources.disk.percent) %>%;background-color:<%= resources.disk.color === 'green' ? '#10b981' : resources.disk.color === 'yellow' ? '#f59e0b' : '#ef4444' %>;height:100%;border-radius:4px;transition:width 0.4s"></div>
          </div>
        </div>

        <div class="resource-bar mb-1">
          <div class="resource-label" style="font-weight:600;margin-bottom:4px">Monthly Bandwidth</div>
          <div class="resource-info" style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
            <span><%= resources.bandwidth.used %> GB / <%= resources.bandwidth.allocated %> GB</span>
            <span style="font-weight:700;color:#10b981"><%= resources.bandwidth.percent %>%</span>
          </div>
          <div class="resource-bar-bg" style="height:7px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden">
            <div class="resource-bar-fill" style="width:<%= resources.bandwidth.percent %>%;background-color:#10b981;height:100%;border-radius:4px"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-title" style="margin:0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        Account Limits &amp; Features
      </div>
      <div style="padding:16px">
        <div class="resource-bar mb-3">
          <div class="resource-label" style="font-weight:600;margin-bottom:4px">IPv4 Addresses</div>
          <div class="resource-info" style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
            <span><%= resources.ipv4.used %> / <%= resources.ipv4.allocated %> Assigned</span>
            <span style="font-weight:700;color:<%= resources.ipv4.color === 'green' ? '#10b981' : resources.ipv4.color === 'yellow' ? '#f59e0b' : '#ef4444' %>"><%= resources.ipv4.percent %>%</span>
          </div>
          <div class="resource-bar-bg" style="height:7px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden">
            <div class="resource-bar-fill" style="width:<%= Math.min(100, resources.ipv4.percent) %>%;background-color:<%= resources.ipv4.color === 'green' ? '#10b981' : resources.ipv4.color === 'yellow' ? '#f59e0b' : '#ef4444' %>;height:100%;border-radius:4px"></div>
          </div>
        </div>

        <div class="resource-bar mb-3">
          <div class="resource-label" style="font-weight:600;margin-bottom:4px">Snapshots Available</div>
          <div class="resource-info" style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
            <span><%= resources.snapshots.used %> / <%= resources.snapshots.allocated %> Used</span>
            <span style="font-weight:700;color:#10b981"><%= resources.snapshots.percent %>%</span>
          </div>
          <div class="resource-bar-bg" style="height:7px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden">
            <div class="resource-bar-fill" style="width:<%= resources.snapshots.percent %>%;background-color:#10b981;height:100%;border-radius:4px"></div>
          </div>
        </div>

        <div class="resource-bar mb-1">
          <div class="resource-label" style="font-weight:600;margin-bottom:4px">Backups Stored</div>
          <div class="resource-info" style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px">
            <span><%= resources.backups.used %> / <%= resources.backups.allocated %> Used</span>
            <span style="font-weight:700;color:<%= resources.backups.color === 'green' ? '#10b981' : resources.backups.color === 'yellow' ? '#f59e0b' : '#ef4444' %>"><%= resources.backups.percent %>%</span>
          </div>
          <div class="resource-bar-bg" style="height:7px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden">
            <div class="resource-bar-fill" style="width:<%= Math.min(100, resources.backups.percent) %>%;background-color:<%= resources.backups.color === 'green' ? '#10b981' : resources.backups.color === 'yellow' ? '#f59e0b' : '#ef4444' %>;height:100%;border-radius:4px"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Live Graphs Section (Chart.js) -->
  <div class="card mb-4">
    <div class="flex-between mb-3">
      <div class="card-title" style="margin:0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Live Workload Graphs (Real-Time Telemetry)
      </div>
      <span class="muted text-sm" id="chartStatus">Live streaming</span>
    </div>
    <div class="grid grid-2" style="gap:16px;padding:8px 4px">
      <!-- CPU Chart -->
      <div style="background:rgba(0,0,0,0.25);border:1px solid var(--border);border-radius:10px;padding:14px">
        <div class="flex-between mb-2">
          <span style="font-weight:700;font-size:13px;color:#fff">CPU Utilization (%)</span>
          <span id="chartCpuBadge" class="mono font-bold" style="color:var(--accent-2);font-size:12px"><%= resources.cpu.percent %>%</span>
        </div>
        <div style="height:180px;position:relative">
          <canvas id="canvasCpu"></canvas>
        </div>
      </div>

      <!-- RAM Chart -->
      <div style="background:rgba(0,0,0,0.25);border:1px solid var(--border);border-radius:10px;padding:14px">
        <div class="flex-between mb-2">
          <span style="font-weight:700;font-size:13px;color:#fff">RAM Consumption (GB)</span>
          <span id="chartRamBadge" class="mono font-bold" style="color:#a855f7;font-size:12px"><%= resources.ram.used %> GB</span>
        </div>
        <div style="height:180px;position:relative">
          <canvas id="canvasRam"></canvas>
        </div>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="empty" style="text-align:center;padding:48px">
    <p style="font-weight:600;font-size:15px;color:var(--text);margin-bottom:4px">No resources data available</p>
    <p class="muted">Deploy a virtual machine to view live quota and resource utilization.</p>
  </div>
  <% } %>
</div>
<%- include('../partials/music') %>
<%- include('../partials/foot') %>

<script>
(function() {
  if (typeof Chart === 'undefined') return;

  const maxPoints = 20;
  const labels = Array.from({ length: maxPoints }, (_, i) => `${maxPoints - i}s ago`);
  const initialCpuData = Array(maxPoints).fill(<%= (resources && resources.cpu.percent) || 0 %>);
  const initialRamData = Array(maxPoints).fill(<%= (resources && resources.ram.used) || 0 %>);

  const ctxCpu = document.getElementById('canvasCpu')?.getContext('2d');
  const ctxRam = document.getElementById('canvasRam')?.getContext('2d');

  let cpuChart = null;
  let ramChart = null;

  if (ctxCpu) {
    cpuChart = new Chart(ctxCpu, {
      type: 'line',
      data: {
        labels: [...labels],
        datasets: [{
          label: 'CPU %',
          data: initialCpuData,
          borderColor: '#38bdf8',
          backgroundColor: 'rgba(56, 189, 248, 0.12)',
          borderWidth: 2,
          fill: true,
          tension: 0.35,
          pointRadius: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        scales: {
          x: { display: false },
          y: {
            min: 0,
            max: 100,
            grid: { color: 'rgba(255,255,255,0.05)' },
            ticks: { color: '#64748b', font: { size: 10 } }
          }
        },
        plugins: { legend: { display: false } }
      }
    });
  }

  if (ctxRam) {
    ramChart = new Chart(ctxRam, {
      type: 'line',
      data: {
        labels: [...labels],
        datasets: [{
          label: 'RAM GB',
          data: initialRamData,
          borderColor: '#a855f7',
          backgroundColor: 'rgba(168, 85, 247, 0.12)',
          borderWidth: 2,
          fill: true,
          tension: 0.35,
          pointRadius: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        scales: {
          x: { display: false },
          y: {
            min: 0,
            suggestedMax: <%= (resources && resources.ram.allocated) || 8 %>,
            grid: { color: 'rgba(255,255,255,0.05)' },
            ticks: { color: '#64748b', font: { size: 10 } }
          }
        },
        plugins: { legend: { display: false } }
      }
    });
  }

  async function pollStats() {
    try {
      const res = await fetch('/resources/stats');
      if (!res.ok) return;
      const data = await res.json();
      if (!data || !data.resources) return;

      const r = data.resources;

      // Update badges & progress bars
      const cpuBadge = document.getElementById('chartCpuBadge');
      if (cpuBadge) cpuBadge.textContent = r.cpu.percent + '%';
      const uiCpuPct = document.getElementById('uiCpuPct');
      if (uiCpuPct) uiCpuPct.textContent = r.cpu.percent + '%';
      const uiCpuBar = document.getElementById('uiCpuBar');
      if (uiCpuBar) uiCpuBar.style.width = Math.min(100, r.cpu.percent) + '%';
      const uiCpuText = document.getElementById('uiCpuText');
      if (uiCpuText) uiCpuText.textContent = `${r.cpu.used} / ${r.cpu.allocated} Cores (${r.cpu.vmAllocated} Cores Provisioned)`;

      const ramBadge = document.getElementById('chartRamBadge');
      if (ramBadge) ramBadge.textContent = r.ram.used + ' GB';
      const uiRamPct = document.getElementById('uiRamPct');
      if (uiRamPct) uiRamPct.textContent = r.ram.percent + '%';
      const uiRamBar = document.getElementById('uiRamBar');
      if (uiRamBar) uiRamBar.style.width = Math.min(100, r.ram.percent) + '%';
      const uiRamText = document.getElementById('uiRamText');
      if (uiRamText) uiRamText.textContent = `${r.ram.used} GB / ${r.ram.allocated} GB (${r.ram.vmAllocated} GB Provisioned)`;

      // Push to charts
      if (cpuChart) {
        cpuChart.data.datasets[0].data.shift();
        cpuChart.data.datasets[0].data.push(r.cpu.percent);
        cpuChart.update();
      }
      if (ramChart) {
        ramChart.data.datasets[0].data.shift();
        ramChart.data.datasets[0].data.push(r.ram.used);
        ramChart.update();
      }
    } catch (_) {}
  }

  setInterval(pollStats, 3000);
})();
</script>